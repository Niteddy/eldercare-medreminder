# ===== LINE Messaging API (จากเมนู Messaging API ใน LINE Developers Console) =====
LINE_CHANNEL_ACCESS_TOKEN=ใส่_Channel_Access_Token_ของคุณ
LINE_CHANNEL_SECRET=ใส่_Channel_Secret_ของคุณ

# ===== LIFF (จากเมนู LIFF ใน LINE Developers Console) =====
LIFF_ID=ใส่_LIFF_ID_ของคุณ เช่น 1234567890-abcdEFGH

# ===== ตั้งค่าเซิร์ฟเวอร์ =====
PORT=3000

# โดเมนของเว็บที่ deploy จริง (ใช้ประกอบ LIFF endpoint URL) เช่น https://your-app.onrender.com
BASE_URL=https://your-app.onrender.com

# ===== รหัสผ่านเข้าหน้าแดชบอร์ดผู้ดูแล (ใช้ Basic Auth แบบง่าย) =====
CAREGIVER_PASSCODE=1234
